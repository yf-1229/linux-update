#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  logapt update [APT_OPTIONS...]
  logapt install <PACKAGE...> [APT_OPTIONS...]
EOF
    exit "${1:-0}"
}

if [ $# -lt 1 ]; then
    usage 1
fi

subcmd="$1"
shift

case "$subcmd" in
    update|install) ;;
    -h|--help) usage 0 ;;
    *) echo "[logapt] Unsupported subcommand: $subcmd" >&2; usage 1 ;;
esac

if ! command -v apt >/dev/null 2>&1; then
    echo "[logapt] apt command not found." >&2
    exit 1
fi

log_dir="${LOGAPT_LOG_DIR:-${HOME:-/tmp}/.logapt}"
mkdir -p "$log_dir"
log_file="$log_dir/${subcmd}-$(date +%Y%m%d-%H%M%S).log"

{
    echo "[logapt] started: $(date -Iseconds)"
    echo "[logapt] command: apt $subcmd $*"
} | tee -a "$log_file"

if apt "$subcmd" "$@" 2>&1 | tee -a "$log_file"; then
    echo "[logapt] finished successfully"
    echo "[logapt] log: $log_file"
else
    status=${PIPESTATUS[0]}
    echo "[logapt] failed with exit code $status" | tee -a "$log_file" >&2
    echo "[logapt] log: $log_file" | tee -a "$log_file" >&2
    exit "$status"
fi
