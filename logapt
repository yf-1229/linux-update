#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  logapt update [APT_OPTIONS...]
  logapt install <PACKAGE...> [APT_OPTIONS...]

Environment:
  LOGAPT_SCROLL_UI=1     Show scrollable package summary before running command
  LOGAPT_SUMMARY_CMD     Optional executable to generate summary per package
EOF
    exit "${1:-0}"
}

collect_install_packages() {
    local pkg
    for pkg in "$@"; do
        case "$pkg" in
            -*) ;;
            *) echo "$pkg" ;;
        esac
    done
}

collect_update_packages() {
    set +e
    apt list --upgradable 2>/dev/null | awk -F/ 'NR > 1 && $1 != "" { print $1 }'
    set -e
}

build_summary_line() {
    local pkg="$1"
    local summary_cmd="${LOGAPT_SUMMARY_CMD:-}"
    local summary="(summary unavailable)"

    if [ -n "$summary_cmd" ] && command -v "$summary_cmd" >/dev/null 2>&1; then
        set +e
        summary="$("$summary_cmd" "apt" "$subcmd" "$pkg" 2>/dev/null)"
        set -e
        [ -n "$summary" ] || summary="(summary unavailable)"
    fi

    printf '%-30s | %s\n' "$pkg" "$summary"
}

show_scrollable_ui() {
    local packages=("$@")
    local tmp_file pager_cmd

    if [ "${#packages[@]}" -eq 0 ]; then
        echo "[logapt] No packages found for summary view."
        return
    fi

    tmp_file="$(mktemp)"
    {
        echo "logapt $subcmd package summary"
        echo "----------------------------------------"
        for pkg in "${packages[@]}"; do
            build_summary_line "$pkg"
        done
    } >"$tmp_file"

    pager_cmd="${PAGER:-less}"
    if command -v "$pager_cmd" >/dev/null 2>&1; then
        "$pager_cmd" "$tmp_file"
    else
        cat "$tmp_file"
    fi
    rm -f "$tmp_file"
}

if [ $# -lt 1 ]; then
    usage 1
fi

subcmd="$1"
shift

case "$subcmd" in
    update|install) ;;
    -h|--help) usage 0 ;;
    *) echo "[logapt] Unsupported subcommand: $subcmd" >&2; usage 1 ;;
esac

if ! command -v apt >/dev/null 2>&1; then
    echo "[logapt] apt command not found." >&2
    exit 1
fi

cmd=(apt "$subcmd" "$@")
printf -v cmd_display '%q ' "${cmd[@]}"

if [ "${LOGAPT_SCROLL_UI:-0}" = "1" ]; then
    mapfile -t packages < <(
        if [ "$subcmd" = "install" ]; then
            collect_install_packages "$@"
        else
            collect_update_packages
        fi
    )
    show_scrollable_ui "${packages[@]}"
fi

log_dir="${LOGAPT_LOG_DIR:-${HOME:?HOME not set}/.logapt}"
mkdir -p "$log_dir"
log_file="$log_dir/${subcmd}-$(date +%Y%m%d-%H%M%S).log"

{
    echo "[logapt] started: $(date -Iseconds)"
    echo "[logapt] command: ${cmd_display% }"
} | tee -a "$log_file"

set +e
"${cmd[@]}" 2>&1 | tee -a "$log_file"
apt_exit_code=${PIPESTATUS[0]}
set -e

if [ "$apt_exit_code" -eq 0 ]; then
    echo "[logapt] finished successfully"
    echo "[logapt] log: $log_file"
else
    echo "[logapt] failed with exit code $apt_exit_code" | tee -a "$log_file" >&2
    echo "[logapt] log: $log_file" | tee -a "$log_file" >&2
    exit "$apt_exit_code"
fi
