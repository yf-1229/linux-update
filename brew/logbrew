#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  logbrew update [BREW_OPTIONS...]
  logbrew upgrade [BREW_OPTIONS...]
  logbrew install <PACKAGE...> [BREW_OPTIONS...]

Environment:
  LOGBREW_SCROLL_UI=1    Show scrollable package summary before running command
  LOGBREW_SUMMARY_CMD    Optional executable to generate summary per package
EOF
    exit "${1:-0}"
}

collect_install_packages() {
    local pkg
    for pkg in "$@"; do
        case "$pkg" in
            -*) ;;
            *) echo "$pkg" ;;
        esac
    done
}

collect_update_packages() {
    set +e
    brew outdated --formula 2>/dev/null
    set -e
}

build_summary_line() {
    local pkg="$1"
    local summary_cmd="${LOGBREW_SUMMARY_CMD:-}"
    local summary="(summary unavailable)"

    if [ -n "$summary_cmd" ] && command -v "$summary_cmd" >/dev/null 2>&1; then
        set +e
        summary="$("$summary_cmd" "brew" "$subcmd" "$pkg" 2>/dev/null)"
        set -e
        [ -n "$summary" ] || summary="(summary unavailable)"
    fi

    printf '%-30s | %s\n' "$pkg" "$summary"
}

show_scrollable_ui() {
    local packages=("$@")
    local tmp_file pager_cmd

    if [ "${#packages[@]}" -eq 0 ]; then
        echo "[logbrew] No packages found for summary view."
        return
    fi

    tmp_file="$(mktemp)"
    {
        echo "logbrew $subcmd package summary"
        echo "----------------------------------------"
        for pkg in "${packages[@]}"; do
            build_summary_line "$pkg"
        done
    } >"$tmp_file"

    pager_cmd="${PAGER:-less}"
    if command -v "$pager_cmd" >/dev/null 2>&1; then
        "$pager_cmd" "$tmp_file"
    else
        cat "$tmp_file"
    fi
    rm -f "$tmp_file"
}

if [ $# -lt 1 ]; then
    usage 1
fi

subcmd="$1"
shift

case "$subcmd" in
    update|upgrade|install) ;;
    -h|--help) usage 0 ;;
    *) echo "[logbrew] Unsupported subcommand: $subcmd" >&2; usage 1 ;;
esac

if ! command -v brew >/dev/null 2>&1; then
    echo "[logbrew] brew command not found." >&2
    exit 1
fi

cmd=(brew "$subcmd" "$@")
printf -v cmd_display '%q ' "${cmd[@]}"

if [ "${LOGBREW_SCROLL_UI:-0}" = "1" ]; then
    mapfile -t packages < <(
        case "$subcmd" in
            install) collect_install_packages "$@" ;;
            update|upgrade) collect_update_packages ;;
        esac
    )
    show_scrollable_ui "${packages[@]}"
fi

log_dir="${LOGBREW_LOG_DIR:-${HOME:?HOME environment variable is not set}/.logbrew}"
mkdir -p "$log_dir"
log_file="$log_dir/${subcmd}-$(date +%Y%m%d-%H%M%S).log"

{
    echo "[logbrew] started: $(date -Iseconds)"
    echo "[logbrew] command: ${cmd_display% }"
} | tee -a "$log_file"

set +e
"${cmd[@]}" 2>&1 | tee -a "$log_file"
brew_exit_code=${PIPESTATUS[0]}
set -e

if [ "$brew_exit_code" -eq 0 ]; then
    echo "[logbrew] finished successfully"
    echo "[logbrew] log: $log_file"
else
    echo "[logbrew] failed with exit code $brew_exit_code" | tee -a "$log_file" >&2
    echo "[logbrew] log: $log_file" | tee -a "$log_file" >&2
    exit "$brew_exit_code"
fi
