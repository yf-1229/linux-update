#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  logapt update [APT_OPTIONS...]
  logapt install <PACKAGE...> [APT_OPTIONS...]
EOF
    exit "${1:-0}"
}

if [ $# -lt 1 ]; then
    usage 1
fi

subcmd="$1"
shift

case "$subcmd" in
    update|install) ;;
    -h|--help) usage 0 ;;
    *) echo "[logapt] Unsupported subcommand: $subcmd" >&2; usage 1 ;;
esac

if ! command -v apt >/dev/null 2>&1; then
    echo "[logapt] apt command not found." >&2
    exit 1
fi

summarize_update() {
    local log_file="$1"
    local upgradable_output upgradable_count

    set +e
    upgradable_output="$(apt list --upgradable 2>/dev/null)"
    set -e

    upgradable_count="$(
        printf '%s\n' "$upgradable_output" \
        | sed '/^Listing\.\.\./d;/^[[:space:]]*$/d' \
        | awk 'END { print NR + 0 }'
    )"

    echo "[logapt] update summary: ${upgradable_count} upgradable package(s)" | tee -a "$log_file"

    if [ "$upgradable_count" -gt 0 ]; then
        printf '%s\n' "$upgradable_output" \
            | sed '/^Listing\.\.\./d;/^[[:space:]]*$/d' \
            | awk -F/ 'NR<=5 { print "[logapt]   - " $1 }' \
            | tee -a "$log_file"

        if [ "$upgradable_count" -gt 5 ]; then
            echo "[logapt]   ...and $((upgradable_count - 5)) more" | tee -a "$log_file"
        fi
    fi
}

cmd=(apt "$subcmd" "$@")
printf -v cmd_display '%q ' "${cmd[@]}"

log_dir="${LOGAPT_LOG_DIR:-${HOME:?HOME environment variable is not set}/.logapt}"
mkdir -p "$log_dir"
log_file="$log_dir/${subcmd}-$(date +%Y%m%d-%H%M%S).log"

{
    echo "[logapt] started: $(date -Iseconds)"
    echo "[logapt] command: ${cmd_display% }"
} | tee -a "$log_file"

set +e
"${cmd[@]}" 2>&1 | tee -a "$log_file"
apt_exit_code=${PIPESTATUS[0]}
set -e

if [ "$apt_exit_code" -eq 0 ]; then
    if [ "$subcmd" = "update" ]; then
        summarize_update "$log_file"
    fi
    echo "[logapt] finished successfully"
    echo "[logapt] log: $log_file"
else
    echo "[logapt] failed with exit code $apt_exit_code" | tee -a "$log_file" >&2
    echo "[logapt] log: $log_file" | tee -a "$log_file" >&2
    exit "$apt_exit_code"
fi
