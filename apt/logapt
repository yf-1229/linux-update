#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  logapt update [APT_OPTIONS...]
  logapt install <PACKAGE...> [APT_OPTIONS...]
EOF
    exit "${1:-0}"
}

if [ $# -lt 1 ]; then
    usage 1
fi

subcmd="$1"
shift

case "$subcmd" in
    update|install) ;;
    -h|--help) usage 0 ;;
    *) echo "[logapt] Unsupported subcommand: $subcmd" >&2; usage 1 ;;
esac

if ! command -v apt >/dev/null 2>&1; then
    echo "[logapt] apt command not found." >&2
    exit 1
fi

exclude_file_default="${HOME:?HOME environment variable is not set}/.config/logapt/exclude-packages.txt"
exclude_file="${LOGAPT_EXCLUDE_FILE:-$exclude_file_default}"
upgradable_output_cache=""
declare -A package_summary_cache=()

sanitize_single_line() {
    tr '\n' ' ' <<<"$1" | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//'
}

load_excluded_packages() {
    if [ -f "$exclude_file" ]; then
        grep -E '^[^#[:space:]].*' "$exclude_file" 2>/dev/null || true
    fi
}

is_excluded_package() {
    local package="$1"
    local excluded
    while IFS= read -r excluded; do
        [ "$excluded" = "$package" ] && return 0
    done < <(load_excluded_packages)
    return 1
}

save_excluded_packages() {
    local -a new_packages=("$@")
    local dir
    dir="$(dirname "$exclude_file")"
    mkdir -p "$dir"
    {
        load_excluded_packages
        printf '%s\n' "${new_packages[@]}"
    } | sed '/^[[:space:]]*$/d' | sort -u > "${exclude_file}.tmp"
    mv "${exclude_file}.tmp" "$exclude_file"
}

ensure_upgradable_output_cache() {
    if [ -z "$upgradable_output_cache" ]; then
        upgradable_output_cache="$(apt list --upgradable 2>/dev/null || true)"
    fi
}

collect_upgradable_packages() {
    ensure_upgradable_output_cache
    printf '%s\n' "$upgradable_output_cache" \
        | sed '/^Listing\.\.\./d;/^[[:space:]]*$/d' \
        | awk -F/ '{print $1}'
}

package_update_summary() {
    local package="$1"
    local line old_version new_version description

    if [ -n "${package_summary_cache[$package]+x}" ]; then
        echo "${package_summary_cache[$package]}"
        return 0
    fi

    ensure_upgradable_output_cache
    line="$(printf '%s\n' "$upgradable_output_cache" | sed '/^Listing\.\.\./d' | awk -F/ -v p="$package" '$1==p {print; exit}')"
    new_version="$(awk '{print $2}' <<<"$line")"
    old_version="$(sed -n 's/.*\[upgradable from: \([^]]*\)\].*/\1/p' <<<"$line")"
    description="$(apt show "$package" 2>/dev/null | sed -n 's/^Description: //p' | head -n1)"
    description="$(sanitize_single_line "${description:-no description}")"
    package_summary_cache["$package"]="${old_version:-unknown} -> ${new_version:-unknown} | ${description}"
    echo "${package_summary_cache[$package]}"
}

show_gui_and_select_exclusions() {
    local -a packages=("$@")
    local -a zenity_rows=()
    local selected
    local package detail

    for package in "${packages[@]}"; do
        detail="$(package_update_summary "$package")"
        zenity_rows+=(FALSE "$package" "$detail")
    done

    selected="$(zenity --list --checklist \
        --title="logapt update list" \
        --text="除外したいパッケージをチェックして「適用」を押してください" \
        --column="除外" --column="Package" --column="Change summary" \
        "${zenity_rows[@]}" \
        --separator="|" \
        --ok-label="適用" \
        --cancel-label="スキップ" \
        --width=1100 --height=640 2>/dev/null || true)"

    printf '%s' "$selected"
}

summarize_update() {
    local log_file="$1"
    local -a upgradable_packages=()
    local -a target_packages=()
    local package selected_exclusions summary
    local target_count
    local gui_enabled=0

    while IFS= read -r package; do
        [ -n "$package" ] && upgradable_packages+=("$package")
    done < <(collect_upgradable_packages)

    for package in "${upgradable_packages[@]}"; do
        if ! is_excluded_package "$package"; then
            target_packages+=("$package")
        fi
    done

    if [ "${LOGAPT_GUI:-1}" = "1" ] && [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1 && [ "${#target_packages[@]}" -gt 0 ]; then
        gui_enabled=1
        selected_exclusions="$(show_gui_and_select_exclusions "${target_packages[@]}")"
        if [ -n "$selected_exclusions" ]; then
            IFS='|' read -r -a new_exclusions <<<"$selected_exclusions"
            save_excluded_packages "${new_exclusions[@]}"
            target_packages=()
            for package in "${upgradable_packages[@]}"; do
                if ! is_excluded_package "$package"; then
                    target_packages+=("$package")
                fi
            done
        fi
    fi

    target_count="${#target_packages[@]}"
    echo "[logapt] update summary: ${target_count} upgradable package(s)" | tee -a "$log_file"
    if [ "$gui_enabled" -eq 1 ]; then
        echo "[logapt] GUI list shown (zenity)" | tee -a "$log_file"
    fi
    echo "[logapt] exclude file: $exclude_file" | tee -a "$log_file"

    if [ "$target_count" -gt 0 ]; then
        local shown=0
        for package in "${target_packages[@]}"; do
            summary="$(package_update_summary "$package")"
            echo "[logapt]   - $package: $summary" | tee -a "$log_file"
            shown=$((shown + 1))
            [ "$shown" -ge 10 ] && break
        done
        if [ "$target_count" -gt 10 ]; then
            echo "[logapt]   ...and $((target_count - 10)) more" | tee -a "$log_file"
        fi
    fi
}

cmd=(apt "$subcmd" "$@")
printf -v cmd_display '%q ' "${cmd[@]}"

log_dir="${LOGAPT_LOG_DIR:-${HOME:?HOME environment variable is not set}/.logapt}"
mkdir -p "$log_dir"
log_file="$log_dir/${subcmd}-$(date +%Y%m%d-%H%M%S).log"

{
    echo "[logapt] started: $(date -Iseconds)"
    echo "[logapt] command: ${cmd_display% }"
} | tee -a "$log_file"

set +e
"${cmd[@]}" 2>&1 | tee -a "$log_file"
apt_exit_code=${PIPESTATUS[0]}
set -e

if [ "$apt_exit_code" -eq 0 ]; then
    if [ "$subcmd" = "update" ]; then
        summarize_update "$log_file"
    fi
    echo "[logapt] finished successfully"
    echo "[logapt] log: $log_file"
else
    echo "[logapt] failed with exit code $apt_exit_code" | tee -a "$log_file" >&2
    echo "[logapt] log: $log_file" | tee -a "$log_file" >&2
    exit "$apt_exit_code"
fi
